{
  "name": "ap-services-marketplace",
  "version": "1.0.0",
  "description": "AP Services Marketplace - Complete Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "node scripts/build-web.js",
    "serve:frontend": "npx serve frontend -l 5500",
    "db:schema": "node database/run-schema.js",
    "db:migrate:booking-audit": "node database/migrate-booking-audit-columns.js",
    "db:migrate:foundation": "node -e \"require('./backend/config/ensureFoundationSchema').ensureFoundationSchema().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:migrate:phase2": "node -e \"require('./backend/config/ensurePhase2Schema').ensurePhase2Schema().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:migrate:reviews-rich": "node database/migrate-reviews-rich-fields.js",
    "db:seed:test": "node database/seeds/test-data-seed.js",
    "test": "node --test backend/tests/**/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "agora-access-token": "^2.0.4",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^17.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
