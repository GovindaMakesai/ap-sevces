# Copy to .env and fill in values

PORT=5000
DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://ap-sevces.vercel.app

# Agora RTC — Console → Project ap_services → App ID + Primary Certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Redis (production multi-instance)
REDIS_URL=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ops
LOG_LEVEL=info
DISABLE_CRON=false
SKIP_DB_SCHEMA_ENSURE=false
