# Copy to .env and fill in values

PORT=5000
# Supabase Glowcast — session pooler (replace YOUR-PASSWORD)
DATABASE_URL=postgresql://postgres.ivvroqvpxwfhzszzsqrq:YOUR-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Access JWT lifetime (default 7d). Short values (15m) cause frequent re-login in the app.
ACCESS_TOKEN_TTL=7d
COOKIE_SECURE=true
# Fast API restarts in production (run migrations manually with FORCE_SCHEMA_ENSURE=true)
SKIP_DB_SCHEMA_ENSURE=true
PG_POOL_MAX=15

# UI + OAuth — use your Render URL
FRONTEND_URL=https://lumoroom.onrender.com
OAUTH_CALLBACK_BASE=https://lumoroom.onrender.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ap-sevces.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=https://ap-sevces.vercel.app/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://ap-sevces.vercel.app/auth/github/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://ap-sevces.vercel.app/auth/facebook/callback

# Agora RTC — project "ap-service" on console.agora.io (Primary Certificate, not temp token)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Redis (production multi-instance)
REDIS_URL=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ops
LOG_LEVEL=info
DISABLE_CRON=false
SKIP_DB_SCHEMA_ENSURE=false
FIREBASE_WEB_API_KEY=
# FCM push (prefer Admin SDK; legacy key is fallback)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FCM_SERVER_KEY=
FCM_SERVER_KEY=
