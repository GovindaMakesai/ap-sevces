# Copy to backend/.env on VPS: /var/www/ap-services/backend/.env
# OAuth callbacks use HTTPS Vercel (proxied to VPS). Do NOT use http://62.72.56.74:5000 for Google/Facebook.

PORT=5000
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DATABASE
JWT_SECRET=change-me-min-32-characters-long
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL=15m
COOKIE_DOMAIN=.apservices.in
COOKIE_SECURE=true

# UI + OAuth HTTPS gateway
FRONTEND_URL=https://ap-sevces.vercel.app
OAUTH_CALLBACK_BASE=https://ap-sevces.vercel.app

# Google — Console → Credentials → OAuth client → Authorized redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ap-sevces.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=https://ap-sevces.vercel.app/auth/google/callback

# GitHub — Settings → Developer settings → OAuth Apps → Authorization callback URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://ap-sevces.vercel.app/auth/github/callback

# Facebook — App → Facebook Login → Valid OAuth Redirect URIs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://ap-sevces.vercel.app/auth/facebook/callback

# Agora live
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Optional
FIREBASE_WEB_API_KEY=
FCM_SERVER_KEY=
REDIS_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
