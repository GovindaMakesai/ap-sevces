{
  "name": "ap-services-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/start-live.js",
    "start:lan": "node ./scripts/start-dev.js",
    "start:expo-only": "expo start",
    "serve:web": "npx http-server ../frontend -p 5500 -a 0.0.0.0 -c-1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "node ./scripts/build-aab.js",
    "build:android:preview": "node ./scripts/build-apk.js",
    "build:apk": "node ./scripts/build-apk.js",
    "build:aab": "node ./scripts/build-aab.js",
    "setup:play-key": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-play-upload-key.ps1",
    "build:local": "node ./scripts/build-local-apk.js",
    "prebuild:android": "expo prebuild --platform android --clean",
    "postprebuild:android": "powershell -ExecutionPolicy Bypass -File ./scripts/patch-android-signing.ps1"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/metro-config": "~54.0.14",
    "eas-cli": "^18.13.1",
    "metro": "^0.83.1"
  },
  "private": true
}
