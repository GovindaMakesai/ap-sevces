    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/metro-config": "~54.0.14",
    "eas-cli": "^18.13.1",
    "metro": "^0.83.1"
  },
  "private": true
