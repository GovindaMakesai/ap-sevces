# Point the Expo app at your local frontend (optional — for dev only)
# 1. Serve frontend/:  npx serve frontend -l 5500
# 2. Use your PC's LAN IP (not localhost) so your phone can reach it
# 3. Copy to .env and restart Expo with cache clear: npx expo start -c
#
# EXPO_PUBLIC_WEB_URL=http://192.168.1.9:5500

